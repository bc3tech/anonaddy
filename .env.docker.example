APP_NAME=AnonAddy
APP_ENV=production
APP_KEY=base64:yPfMQdmT+AJnh6bpyIh/aclBfruFR+m+04vvGCN8uBA=
APP_DEBUG=false
APP_URL=http://localhost:8080
# Set to * when running behind a trusted reverse proxy that terminates TLS.
TRUSTED_PROXIES=
LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=anonaddy
DB_USERNAME=anonaddy
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=false
SAME_SITE_COOKIES=lax

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_FROM_NAME=AnonAddy
MAIL_FROM_ADDRESS=DoNotReply@example.com
MAIL_DRIVER=acs
MAIL_MAILER=acs
MAIL_ACS_ENDPOINT=https://your-communication-service.communication.azure.com
MAIL_ACS_ACCESS_KEY=
MAIL_ACS_API_VERSION=2023-03-31
MAIL_HOST=mail
MAIL_PORT=25
MAIL_ENCRYPTION=null
MAIL_EHLO_DOMAIN=mail.example.com
MAIL_VERIFY_PEER=true

ANONADDY_RETURN_PATH=mailer@example.com
ANONADDY_ADMIN_USERNAME=admin
ANONADDY_ENABLE_REGISTRATION=true
ANONADDY_DOMAIN=example.com
ANONADDY_HOSTNAME=mail.example.com
ANONADDY_DNS_RESOLVER=1.1.1.1
ANONADDY_ALL_DOMAINS=example.com
ANONADDY_SECRET=replace-this-with-a-long-random-string
ANONADDY_LIMIT=200
ANONADDY_BANDWIDTH_LIMIT=104857600
ANONADDY_NEW_ALIAS_LIMIT=100
ANONADDY_ADDITIONAL_USERNAME_LIMIT=10
ANONADDY_SIGNING_KEY_FINGERPRINT=
ANONADDY_DKIM_SIGNING_KEY=
ANONADDY_DKIM_SELECTOR=default
ANONADDY_NON_ADMIN_USERNAME_SUBDOMAINS=true
ANONADDY_NON_ADMIN_SHARED_DOMAINS=true
ANONADDY_USE_PROXY_AUTHENTICATION=false

BLOCKLIST_API_ALLOWED_IPS=127.0.0.1
BLOCKLIST_API_SECRET=replace-this-with-a-long-random-string

POSTFIX_LOG_PATH=/var/log/mail/mail.log
POSTFIX_MYNETWORKS=172.28.0.0/16
DOCKER_SUBNET=172.28.0.0/16
