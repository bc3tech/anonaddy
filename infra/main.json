                "name": "DB_DATABASE",
                "value": "[parameters('mysqlDatabase')]"
              },
              {
                "name": "DB_USERNAME",
                "value": "[parameters('mysqlUsername')]"
              },
              {
                "name": "DB_PASSWORD",
                "secretRef": "mysql-password"
              },
              {
                "name": "CACHE_DRIVER",
                "value": "file"
              },
              {
                "name": "QUEUE_CONNECTION",
                "value": "sync"
              },
              {
                "name": "SESSION_DRIVER",
                "value": "file"
              },
              {
                "name": "SESSION_SECURE_COOKIE",
                "value": "true"
              },
              {
                "name": "SAME_SITE_COOKIES",
                "value": "lax"
              },
              {
                "name": "ANONADDY_DOMAIN",
                "value": "[parameters('anonaddyDomain')]"
              },
              {
                "name": "ANONADDY_ALL_DOMAINS",
                "value": "[parameters('anonaddyAllDomains')]"
              },
              {
                "name": "ANONADDY_HOSTNAME",
                "value": "[parameters('anonaddyHostname')]"
              },
              {
                "name": "ANONADDY_ADMIN_USERNAME",
                "value": "[parameters('anonaddyAdminUsername')]"
              },
              {
                "name": "ANONADDY_RETURN_PATH",
                "value": "[parameters('anonaddyReturnPath')]"
              },
              {
                "name": "ANONADDY_ENABLE_REGISTRATION",
                "value": "true"
              },
              {
                "name": "ANONADDY_NON_ADMIN_USERNAME_SUBDOMAINS",
                "value": "true"
              },
              {
                "name": "ANONADDY_NON_ADMIN_SHARED_DOMAINS",
                "value": "true"
              },
              {
                "name": "ANONADDY_SECRET",
                "secretRef": "anonaddy-secret"
              },
              {
                "name": "BLOCKLIST_API_SECRET",
                "secretRef": "blocklist-api-secret"
              },
              {
                "name": "MAIL_MAILER",
                "value": "acs"
              },
              {
                "name": "MAIL_DRIVER",
                "value": "acs"
              },
              {
                "name": "MAIL_FROM_NAME",
                "value": "[parameters('mailFromName')]"
              },
              {
                "name": "MAIL_FROM_ADDRESS",
                "value": "[parameters('mailFromAddress')]"
              },
              {
                "name": "MAIL_ACS_ENDPOINT",
                "value": "[parameters('mailAcsEndpoint')]"
              },
              {
                "name": "MAIL_ACS_ACCESS_KEY",
                "secretRef": "mail-acs-access-key"
              },
              {
                "name": "MAIL_ACS_API_VERSION",
                "value": "2023-03-31"
              }
            ]
          },
          "resources": [
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2024-03-01",
              "name": "[parameters('environmentName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "appLogsConfiguration": {
                  "destination": "log-analytics",
                  "logAnalyticsConfiguration": {
                    "customerId": "[parameters('logAnalyticsCustomerId')]",
                    "sharedKey": "[parameters('logAnalyticsSharedKey')]"
                  }
                },
                "vnetConfiguration": {
                  "infrastructureSubnetId": "[parameters('infrastructureSubnetId')]",
                  "internal": false
                }
              }
            },
            {
              "type": "Microsoft.App/managedEnvironments/storages",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('environmentName'), 'app-storage')]",
              "properties": {
                "azureFile": {
                  "accountName": "[parameters('storageAccountName')]",
                  "accountKey": "[parameters('storageAccountKey')]",
                  "shareName": "app-storage",
                  "accessMode": "ReadWrite"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "type": "Microsoft.App/managedEnvironments/storages",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('environmentName'), 'mysql-data')]",
              "properties": {
                "azureFile": {
                  "accountName": "[parameters('storageAccountName')]",
                  "accountKey": "[parameters('storageAccountKey')]",
                  "shareName": "mysql-data",
                  "accessMode": "ReadWrite"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "type": "Microsoft.App/managedEnvironments/storages",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('environmentName'), 'mail-certs')]",
              "properties": {
                "azureFile": {
                  "accountName": "[parameters('storageAccountName')]",
                  "accountKey": "[parameters('storageAccountKey')]",
                  "shareName": "mail-certs",
                  "accessMode": "ReadWrite"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "type": "Microsoft.App/managedEnvironments/storages",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('environmentName'), 'mail-logs')]",
              "properties": {
                "azureFile": {
                  "accountName": "[parameters('storageAccountName')]",
                  "accountKey": "[parameters('storageAccountKey')]",
                  "shareName": "mail-logs",
                  "accessMode": "ReadWrite"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "type": "Microsoft.App/managedEnvironments/storages",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('environmentName'), 'mail-spool')]",
              "properties": {
                "azureFile": {
                  "accountName": "[parameters('storageAccountName')]",
                  "accountKey": "[parameters('storageAccountKey')]",
                  "shareName": "mail-spool",
                  "accessMode": "ReadWrite"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[parameters('mysqlName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "configuration": {
                  "activeRevisionsMode": "Single",
                  "ingress": {
                    "external": false,
                    "targetPort": 3306,
                    "exposedPort": 3306,
                    "transport": "tcp"
                  },
                  "secrets": [
                    {
                      "name": "mysql-password",
                      "value": "[parameters('mysqlPassword')]"
                    },
                    {
                      "name": "mysql-root-password",
                      "value": "[parameters('mysqlRootPassword')]"
                    }
                  ]
                },
                "template": {
                  "scale": {
                    "minReplicas": "[parameters('mysqlMinReplicas')]",
                    "maxReplicas": 1,
                    "rules": [
                      {
                        "name": "tcp",
                        "tcp": {
                          "metadata": {
                            "concurrentConnections": "10"
                          }
                        }
                      }
                    ]
                  },
                  "containers": [
                    {
                      "name": "mysql",
                      "image": "[variables('mysqlImage')]",
                      "resources": {
                        "cpu": "[json('0.25')]",
                        "memory": "0.5Gi"
                      },
                      "env": [
                        {
                          "name": "MYSQL_DATABASE",
                          "value": "[parameters('mysqlDatabase')]"
                        },
                        {
                          "name": "MYSQL_USER",
                          "value": "[parameters('mysqlUsername')]"
                        },
                        {
                          "name": "MYSQL_PASSWORD",
                          "secretRef": "mysql-password"
                        },
                        {
                          "name": "MYSQL_ROOT_PASSWORD",
                          "secretRef": "mysql-root-password"
                        }
                      ],
                      "volumeMounts": [
                        {
                          "volumeName": "mysql-data",
                          "mountPath": "/var/lib/mysql"
                        }
                      ]
                    }
                  ],
                  "volumes": [
                    {
                      "name": "mysql-data",
                      "storageName": "mysql-data",
                      "storageType": "AzureFile"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), 'mysql-data')]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[parameters('appName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('identityId'))]": {}
                }
              },
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "configuration": {
                  "activeRevisionsMode": "Single",
                  "registries": [
                    {
                      "server": "[parameters('acrLoginServer')]",
                      "identity": "[parameters('identityId')]"
                    }
                  ],
                  "ingress": {
                    "external": true,
                    "targetPort": 80,
                    "transport": "http",
                    "allowInsecure": false
                  },
                  "secrets": "[variables('commonSecrets')]"
                },
                "template": {
                  "scale": {
                    "minReplicas": "[parameters('appMinReplicas')]",
                    "maxReplicas": 1
                  },
                  "containers": [
                    {
                      "name": "app",
                      "image": "[variables('placeholderImage')]",
                      "command": [
                        "sh",
                        "-c"
                      ],
                      "args": [
                        "mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/framework/testing storage/logs && php artisan migrate --force && php artisan storage:link --force && /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.conf"
                      ],
                      "resources": {
                        "cpu": "[json('0.25')]",
                        "memory": "0.5Gi"
                      },
                      "env": "[variables('commonEnv')]",
                      "volumeMounts": [
                        {
                          "volumeName": "app-storage",
                          "mountPath": "/var/www/html/storage"
                        }
                      ]
                    }
                  ],
                  "volumes": [
                    {
                      "name": "app-storage",
                      "storageName": "app-storage",
                      "storageType": "AzureFile"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), 'app-storage')]",
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "[resourceId('Microsoft.App/containerApps', parameters('mysqlName'))]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[parameters('mailName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('identityId'))]": {}
                }
              },
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "configuration": {
                  "activeRevisionsMode": "Single",
                  "registries": [
                    {
                      "server": "[parameters('acrLoginServer')]",
                      "identity": "[parameters('identityId')]"
                    }
                  ],
                  "ingress": {
                    "external": true,
                    "targetPort": 25,
                    "exposedPort": 25,
                    "transport": "tcp"
                  },
                  "secrets": "[variables('commonSecrets')]"
                },
                "template": {
                  "scale": {
                    "minReplicas": "[parameters('mailMinReplicas')]",
                    "maxReplicas": 1,
                    "rules": [
                      {
                        "name": "smtp",
                        "tcp": {
                          "metadata": {
                            "concurrentConnections": "10"
                          }
                        }
                      }
                    ]
                  },
                  "containers": [
                    {
                      "name": "mail",
                      "image": "[variables('placeholderImage')]",
                      "command": [
                        "sh",
                        "-c"
                      ],
                      "args": [
                        "mkdir -p /var/www/html/storage/framework/cache /var/www/html/storage/framework/sessions /var/www/html/storage/framework/views /var/www/html/storage/framework/testing /var/www/html/storage/logs && /usr/local/bin/anonaddy-mail-entrypoint"
                      ],
                      "resources": {
                        "cpu": "[json('0.25')]",
                        "memory": "0.5Gi"
                      },
                      "env": "[concat(variables('commonEnv'), createArray(createObject('name', 'POSTFIX_MYNETWORKS', 'value', '10.42.0.0/16'), createObject('name', 'POSTFIX_LOG_PATH', 'value', '/var/log/mail/mail.log')))]",
                      "volumeMounts": [
                        {
                          "volumeName": "app-storage",
                          "mountPath": "/var/www/html/storage"
                        },
                        {
                          "volumeName": "mail-certs",
                          "mountPath": "/etc/postfix/certs"
                        },
                        {
                          "volumeName": "mail-logs",
                          "mountPath": "/var/log/mail"
                        },
                        {
                          "volumeName": "mail-spool",
                          "mountPath": "/var/spool/postfix"
                        }
                      ]
                    }
                  ],
                  "volumes": [
                    {
                      "name": "app-storage",
                      "storageName": "app-storage",
                      "storageType": "AzureFile"
                    },
                    {
                      "name": "mail-certs",
                      "storageName": "mail-certs",
                      "storageType": "AzureFile"
                    },
                    {
                      "name": "mail-logs",
                      "storageName": "mail-logs",
                      "storageType": "AzureFile"
                    },
                    {
                      "name": "mail-spool",
                      "storageName": "mail-spool",
                      "storageType": "AzureFile"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), 'app-storage')]",
                "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
                "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), 'mail-certs')]",
                "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), 'mail-logs')]",
                "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), 'mail-spool')]",
                "[resourceId('Microsoft.App/containerApps', parameters('mysqlName'))]"
              ]
            }
          ],
          "outputs": {
            "appFqdn": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn)]"
            },
            "mailFqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('mailName')), '2024-03-01').configuration.ingress.fqdn]"
            }
          }
        }
      },
      "dependsOn": [
        "core",
        "network",
        "rg"
      ]
    }
  },
  "outputs": {
    "RESOURCE_GROUP_NAME": {
      "type": "string",
      "value": "[variables('resourceGroupName')]"
    },
    "AZURE_CONTAINER_REGISTRY_ENDPOINT": {
      "type": "string",
      "value": "[reference('core').outputs.acrLoginServer.value]"
    },
    "APP_CONTAINER_APP_NAME": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "MAIL_CONTAINER_APP_NAME": {
      "type": "string",
      "value": "[variables('mailName')]"
    },
    "MYSQL_CONTAINER_APP_NAME": {
      "type": "string",
      "value": "[variables('mysqlName')]"
    },
    "CONTAINER_APP_ENVIRONMENT_NAME": {
      "type": "string",
      "value": "[variables('environmentNameActual')]"
    },
    "APP_URL": {
      "type": "string",
      "value": "[reference('apps').outputs.appFqdn.value]"
    },
    "SMTP_HOSTNAME": {
      "type": "string",
      "value": "[reference('apps').outputs.mailFqdn.value]"
    }
  }
}